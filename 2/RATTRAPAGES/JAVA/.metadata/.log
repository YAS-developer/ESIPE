	private final ArrayList<T> list = new ArrayList<T>(); 
	private final HashMap<T, T> map = new HashMap<T, T>();
	
	public DedupVec(){
		
	}
	
	public void add(T item) {
		Objects.requireNonNull(item);
		
		var val = map.putIfAbsent(item, item);
		
		
